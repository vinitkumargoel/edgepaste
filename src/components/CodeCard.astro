---
interface Props {
  /** highlight() output — always wrapped in a `.shiki` <pre>. Trusted, server-built. */
  html: string;
  /** Number of gutter rows to render. */
  lineCount: number;
}

const { html, lineCount } = Astro.props;

const rows = Math.max(1, lineCount);
// Generated by us, not by the user: digits and newlines only.
const gutter = Array.from({ length: rows }, (_, i) => String(i + 1)).join('\n');
---

<div class="code-card lines" id="code-card"><pre class="gutter" aria-hidden="true">{gutter}</pre><Fragment set:html={html} /></div>
